{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "System.Net.Http.HttpClient": "Warning",
      "Microsoft.Extensions.Http": "Warning"
    }
  },
  "Scraping": {
    "FromYear": 2024,
    "MinRequestInterval": "00:00:01",
    "DataDirectory": "data",
    "IncludeAnexos": false
  },
  "Chunking": {
    "TargetTokens": 500,
    "OverlapTokens": 80,
    "TokenizerModelPath": "data/models/sentencepiece.bpe.model",
    "AllowApproximateTokenizer": false
  }
}
