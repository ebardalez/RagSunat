{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "System.Net.Http.HttpClient": "Warning",
      "Microsoft.Extensions.Http": "Warning"
    }
  },
  "Scraping": {
    "FromYear": 2024,
    "MinRequestInterval": "00:00:01",
    "DataDirectory": "data",
    "IncludeAnexos": false
  },
  "Chunking": {
    "TargetTokens": 500,
    "OverlapTokens": 80,
    "TokenizerModelPath": "data/models/sentencepiece.bpe.model",
    "AllowApproximateTokenizer": false
  },
  "Index": {
    "DatabasePath": "data/sunat.db",
    "CollectionName": "chunks",
    "EmbeddingBatchSize": 16,
    "EmbeddingBatchTokenBudget": 6000,
    "EmbeddingRecipe": "v1"
  },
  "Guard": {
    "Enabled": true,
    "MaxBestDistance": 0.46
  },
  "Retrieval": {
    "CandidatesPerRanker": 30,
    "RrfK": 60,
    "VectorWeight": 1.0,
    "KeywordWeight": 1.0,
    "TopK": 6,
    "MaxChunksPerDocument": 3,
    "ReservedSystemTokens": 1500,
    "ReservedHistoryTokens": 2000,
    "ReservedAnswerTokens": 4096,
    "ChatTokenSafetyFactor": 1.30
  }
}
