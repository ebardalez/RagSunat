{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "System.Net.Http.HttpClient": "Warning",
      "Microsoft.Extensions.Http": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Index": {
    "DatabasePath": "data/sunat.db",
    "CollectionName": "chunks"
  },
  "Guard": {
    "Enabled": true,
    "MaxBestDistance": 0.46
  },
  "Retrieval": {
    "TopK": 6,
    "MaxChunksPerDocument": 3,
    "ReservedSystemTokens": 1500,
    "ReservedHistoryTokens": 2000,
    "ReservedAnswerTokens": 4096,
    "ChatTokenSafetyFactor": 1.25
  },
  "Agent": {
    "Retrieval": "ContextProvider",
    "SkillsPath": "skills",
    "EnableSkills": true,
    "Reasoning": "None",
    "Temperature": 0.2,
    "CompactHistory": true,
    "WeakMatchDistance": 0.40
  }
}
